{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/stores/editorStore.ts",
    "src/stores/authStore.ts",
    "src/api/request.ts",
    "src/registry/componentRegistry.ts",
    "src/utils/logger.ts",
    "src/utils/toast.ts",
    "src/utils/errorHandler.ts",
    "src/composables/useAnimation.ts",
    "src/composables/useDevicePreview.ts",
    "src/composables/useAlignmentGuides.ts",
    "src/composables/useTheme.ts",
    "src/composables/useAutoSave.ts",
    "src/composables/useProjectManager.ts",
    "src/composables/useKeyboardShortcuts.ts",
    "src/composables/useAIAssistant.ts"
  ],
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "coverage/mutation/mutation.html" },
  "jsonReporter": { "fileName": "coverage/mutation/mutation.json" },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "thresholds": { "high": 80, "low": 60, "break": 95 },
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 30000,
  "concurrency": 4
}
