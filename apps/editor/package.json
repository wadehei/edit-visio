{
  "name": "@page-builder/editor",
  "version": "1.0.0",
  "description": "可视化页面编辑器 - Vue 3 版本",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@page-builder/components": "workspace:*",
    "@page-builder/core": "workspace:*",
    "@page-builder/shared": "workspace:*",
    "axios": "^1.20.0",
    "lucide-vue-next": "^0.303.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.3.5",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-vue": "^10.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
