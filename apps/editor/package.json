{
  "name": "@page-builder/editor",
  "version": "1.0.0",
  "description": "可视化页面编辑器 - Vue 3 版本",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@page-builder/components": "workspace:*",
    "@page-builder/core": "workspace:*",
    "@page-builder/shared": "workspace:*",
    "axios": "^1.20.0",
    "lucide-vue-next": "^0.303.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.3",
    "vue": "^3.4.0",
    "vue-draggable-plus": "^0.3.5",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-vue": "^9.19.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "1.6.1",
    "vue-tsc": "^1.8.27"
  }
}
